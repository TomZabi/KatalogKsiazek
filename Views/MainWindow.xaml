<Window x:Class="KatalogKsiazek.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KatalogKsiazek.ViewModels"
        xmlns:h="clr-namespace:KatalogKsiazek.Helpers"
        Title="Katalog książek (MVVM)"
        Height="640" Width="1100"
        MinHeight="500" MinWidth="800"
        FontSize="13"
        Closing="Window_Closing">

    <Window.Resources>
        <h:StringToImageSourceConverter x:Key="OkladkaConverter"/>

        <Style x:Key="BladStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidocznyGdyWybrana" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaWybrana}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidocznyGdyBrakWybranej" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaWybrana}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA KOLUMNA -->
        <GroupBox Header="Lista książek" Grid.Column="0">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Filtr, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0"
                             ToolTip="Szukaj po tytule lub autorze"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CzyscWyszukiwanieCommand}"
                            Padding="6,2"
                            ToolTip="Wyczyść wyszukiwanie"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding GatunkiFiltr}"
                              SelectedItem="{Binding FiltrGatunek}"
                              Margin="0,0,4,0"
                              ToolTip="Filtruj po gatunku"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StanyFiltr}"
                              SelectedItem="{Binding FiltrStan}"
                              Margin="0,0,4,0"
                              ToolTip="Filtruj po stanie czytania"/>
                    <Button Grid.Column="2"
                            Content="✕ Filtry"
                            Command="{Binding CzyscFiltryCommand}"
                            Padding="6,2"
                            ToolTip="Wyczyść wszystkie filtry"/>
                </Grid>

                <!-- Sortowanie -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sortuj:" VerticalAlignment="Center"
                               Margin="0,0,6,0" Foreground="Gray"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SortowanieOpcje}"
                              SelectedItem="{Binding WybraneSortowanie}"/>
                </Grid>

                <!-- Filtr: data przeczytania -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Przeczytana od:"
                               VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding FiltrDataOd}"
                                Margin="0,0,6,0"
                                ToolTip="Filtruj: data przeczytania od"/>
                    <TextBlock Grid.Column="2" Text="do:"
                               VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
                    <DatePicker Grid.Column="3"
                                SelectedDate="{Binding FiltrDataDo}"
                                ToolTip="Filtruj: data przeczytania do"/>
                </Grid>

                <!-- Filtr: zakres roku wydania -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rok wydania od:"
                               VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding FiltrRokOd, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,6,0"
                             ToolTip="Rok wydania od (np. 1950)"/>
                    <TextBlock Grid.Column="2" Text="do:"
                               VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding FiltrRokDo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Rok wydania do (np. 2024)"/>
                </Grid>

                <Button DockPanel.Dock="Top"
                        Content="➤ Nowa książka"
                        Command="{Binding NowaKsiazkaCommand}"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        Margin="0,0,0,6"/>

                <ListBox x:Name="ListaKsiazek"
                         ItemsSource="{Binding Ksiazki}"
                         SelectedItem="{Binding Wybrana, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         MouseDown="ListaKsiazek_MouseDown">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Miniatura okładki -->
                                <Border Grid.Column="0" Width="36" Height="52" Margin="0,0,8,0"
                                        BorderBrush="#DDD" BorderThickness="1" Background="#F0F0F0"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OkladkaSciezka}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding OkladkaSciezka,
                                                   Converter={StaticResource OkladkaConverter}}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <!-- Treść elementu -->
                                <StackPanel Grid.Column="1">
                                <!-- Zawsze widoczny: ikonka stanu + tytuł -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StanIkona, Mode=OneWay}"
                                               Margin="0,0,6,0"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Tytul}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tytul}" Value="">
                                                        <Setter Property="Text" Value="(Nowa...)"/>
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- Zawsze widoczny autor -->
                                <TextBlock Text="{Binding Autor, Mode=OneWay}"
                                           Foreground="#555" FontSize="11" Margin="0,1,0,0"/>
                                <!-- Szczegóły widoczne po zaznaczeniu (IsSelected trigger) -->
                                <StackPanel Margin="0,4,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=IsSelected,
                                                    RelativeSource={RelativeSource Mode=FindAncestor,
                                                    AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Foreground="#444">
                                        <Run FontWeight="SemiBold" Text="{Binding Autor, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#666" Margin="0,2,0,0">
                                        <Run Text="{Binding StanOpis, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Gatunek, Mode=OneWay}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Rok, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#888" Margin="0,1,0,0">
                                        <Run Text="Ocena: "/>
                                        <Run Text="{Binding OcenaOpis, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#CCC"
                      ShowsPreview="True"/>

        <!-- PRAWA KOLUMNA -->
        <GroupBox Header="Szczegóły książki" Grid.Column="2">
            <Grid>

                <TextBlock Style="{StaticResource WidocznyGdyBrakWybranej}"
                           Text="Wybierz książkę z listy lub dodaj nową."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="20"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource WidocznyGdyWybrana}">
                    <StackPanel Margin="10">

                        <TextBlock Text="Tytuł" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Tytul, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding BladTytul}" Style="{StaticResource BladStyle}"/>

                        <TextBlock Text="Autor" FontWeight="SemiBold"/>
                        <ComboBox IsEditable="True"
                                  Text="{Binding Autor, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AutorzyListy}"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding BladAutor}" Style="{StaticResource BladStyle}"/>

                        <TextBlock Text="Rok" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RokText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding BladRok}" Style="{StaticResource BladStyle}"/>

                        <TextBlock Text="Gatunek" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Gatunki}"
                                  SelectedItem="{Binding Gatunek}"
                                  IsEditable="True"
                                  Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding BladGatunek}" Style="{StaticResource BladStyle}"/>

                        <TextBlock Text="Stan" FontWeight="SemiBold"/>
                        <StackPanel Margin="0,4,0,8">
                            <RadioButton Content="📚 Nowa"
                                         IsChecked="{Binding StanNowa}"
                                         GroupName="Stan" Margin="0,2"/>
                            <RadioButton Content="📖 W trakcie"
                                         IsChecked="{Binding StanWTrakcie}"
                                         GroupName="Stan" Margin="0,2"/>
                            <RadioButton Content="✅ Przeczytana"
                                         IsChecked="{Binding StanPrzeczytana}"
                                         GroupName="Stan" Margin="0,2"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Ocena: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OcenaOpis}"/>
                        </StackPanel>

                        <Slider Minimum="1" Maximum="10"
                                Value="{Binding Ocena}"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Margin="0,4,0,2"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="1"  Foreground="Gray" FontSize="11" HorizontalAlignment="Left"/>
                            <TextBlock Text="10" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Uwagi" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,2,0,10"/>

                        <!-- Data przeczytania – zawsze widoczna, ręczne wpisanie lub kalendarz -->
                        <TextBlock Text="Data przeczytania" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding DataPrzeczytaniaForm}"
                                    IsEnabled="True"
                                    ToolTip="Wpisz datę ręcznie (np. 2026-05-30) lub wybierz z kalendarza"
                                    Margin="0,2,0,8"/>

                        <TextBlock Text="Wydawnictwo" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Wydawnictwo, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,8"/>

                        <TextBlock Text="Okładka" FontWeight="SemiBold"/>
                        <Border Margin="0,4,0,4" BorderBrush="#CCC" BorderThickness="1"
                                Background="#F8F8F8" Width="120" Height="170"
                                HorizontalAlignment="Left">
                            <Grid>
                                <TextBlock Text="Brak okładki" Foreground="Gray" FontStyle="Italic"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaOkladke}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding OkladkaSciezka,
                                               Converter={StaticResource OkladkaConverter}}"
                                       Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="📂 Wybierz okładkę"
                                    Command="{Binding WybierzOkladkeCommand}"
                                    Padding="6,4" Margin="0,0,6,0"/>
                            <Button Content="✕ Usuń"
                                    Command="{Binding UsunOkladkeCommand}"
                                    Padding="6,4"
                                    ToolTip="Usuń okładkę"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Liczba stron" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding LiczbaStronText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding BladLiczbaStron}" Style="{StaticResource BladStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ISBN" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding ISBN, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,2"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="💾 Zapisz"
                                    Command="{Binding ZapiszCommand}"
                                    Padding="6"
                                    FontWeight="SemiBold"/>
                            <Button Grid.Column="2"
                                    Content="✕ Anuluj"
                                    Command="{Binding AnulujCommand}"
                                    Padding="6"/>
                        </Grid>

                        <Button Content="🗑️ Usuń książkę"
                                Command="{Binding UsunCommand}"
                                Padding="6"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </GroupBox>

    </Grid>
</Window>